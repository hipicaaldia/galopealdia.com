# Headers de seguridad — Cloudflare Pages aplica este archivo
# automáticamente. Cero impacto en peso de la web (solo cabeceras HTTP).
# Doc: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Forzar HTTPS durante 2 años + subdominios (HSTS).
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Evita que el navegador adivine MIME types (XSS via uploads).
  X-Content-Type-Options: nosniff

  # No permitir embebido en iframes de terceros (clickjacking).
  X-Frame-Options: SAMEORIGIN

  # Solo enviar referer al mismo dominio (privacidad).
  Referrer-Policy: strict-origin-when-cross-origin

  # Limitar APIs del navegador a las que NO usamos.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

  # Cross-Origin policies. 2026-05-30: CORP cross-origin para Worker preview.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin

# 2026-09-30 (AdSense): las fichas individuales de estadísticas (caballo,
# jinete, preparador, propietario) son páginas de <150 palabras. Fuera del
# índice de Google, incluidas las ~400 viejas que ya no genera nadie pero
# siguen en el repo. Los rankings (/estadisticas/<tipo>/) siguen indexables.
/estadisticas/:tipo/:ficha
  X-Robots-Tag: noindex, follow
